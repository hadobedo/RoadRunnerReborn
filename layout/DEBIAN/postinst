#!/bin/sh
# RoadRunner Reborn post-install hook.
# Request a Sileo userspace reboot instead of killing runningboardd directly.

printf '%s\n' 'Thanks for installing RoadRunner Reborn!'

finish_userspace_reboot() {
    [ -n "$SILEO" ] || return 0

    read -r fd version <<EOF
$SILEO
EOF
    [ -n "$fd" ] || return 0
    [ "${version:-0}" -ge 1 ] || return 0

    printf 'finish:usreboot\n' >&"$fd"
}

case "$1" in
    configure|triggered)
        finish_userspace_reboot
        ;;
esac

exit 0
